  displayName: "\uD654\uC5FC\uAD6C"
  summary: "\uD654\uC5FC\uAD6C\uAC00 \uC801\uC5D0\uAC8C \uB9DE\uC73C\uBA74 \uD3ED\uBC1C\uD574
    \uC8FC\uBCC0 \uC801\uC5D0\uAC8C \uD53C\uD574\uB97C \uC785\uD799\uB2C8\uB2E4.\t"
  behavior: "\uC785\uB825 \uBC29\uD5A5\uC73C\uB85C \uBC1C\uC0AC\uD558\uBA70, \uC785\uB825\uC774
    \uC5C6\uC73C\uBA74 \uBC14\uB77C\uBCF4\uB294 \uBC29\uD5A5\uC73C\uB85C \uBC1C\uC0AC\uD569\uB2C8\uB2E4.
    \uCDA9\uB3CC\uD558\uBA74 \uBC18\uACBD 3m \uC548\uC5D0 \uD3ED\uBC1C \uD53C\uD574\uB97C
    \uC785\uD788\uACE0 \uC18C\uBA78\uD569\uB2C8\uB2E4. \uC720\uB3C4 \uC99D\uAC15\uC744
    \uC5BB\uC73C\uBA74 \uBC18\uACBD 5m \uC548\uC758 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4
    \uC801\uC744 \uCD94\uC801\uD569\uB2C8\uB2E4. \uCD94\uC801\uD560 \uC801\uC774
    \uC5C6\uC73C\uBA74 \uAE30\uC874 \uBC29\uD5A5\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4.
    \uD53C\uD574\uB294 \uD3ED\uBC1C \uC2DC \uC801\uC6A9\uB429\uB2C8\uB2E4."
  baseStats: "\uBC1C\uB3D9 \uAC04\uACA9 3.5\uCD08 / \uD22C\uC0AC\uCCB4 \uC218 1\uAC1C
    / \uC774\uB3D9\uC18D\uB3C4 5m/s / \uD06C\uAE30 1.0\uBC30\n\uD3ED\uBC1C \uBC18\uACBD
    3m / \uC720\uB3C4 \uD0D0\uC0C9 \uBC18\uACBD 5m"

  displayName: "\uB3C4\uAEA0\uBE44\uBD88"
  summary: "\uD50C\uB808\uC774\uC5B4 \uC8FC\uC704\uB97C \uB3C4\uB294 \uB3C4\uAE68\uBE44\uBD88\uC744
    \uC18C\uD658\uD569\uB2C8\uB2E4. \uC801\uC744 \uAC10\uC9C0\uD558\uBA74 \uBA48\uCDB0
    \uD22C\uC0AC\uCCB4\uB97C \uBC1C\uC0AC\uD569\uB2C8\uB2E4."
  behavior: "\uCE90\uB9AD\uD130 \uC804\uBC29 1m\uC5D0 \uC0DD\uC131\uB429\uB2C8\uB2E4.
    \uACF5\uC804 \uC911 \uC790\uAE30 \uC8FC\uBCC0 3m \uC548\uC5D0\uC11C \uAC00\uC7A5
    \uAC00\uAE4C\uC6B4 \uC801\uC744 \uAC10\uC9C0\uD558\uBA74 \uBA48\uCDB0 \uD22C\uC0AC\uCCB4\uB97C
    \uC3E9\uB2C8\uB2E4. \uBC94\uC704 \uC548\uC5D0 \uC801\uC774 \uC5C6\uC73C\uBA74
    \uACF5\uC804\uC744 \uC7AC\uAC1C\uD569\uB2C8\uB2E4. \uC9C0\uC18D\uC2DC\uAC04\uC774
    \uB05D\uB098\uAC70\uB098 \uB2E4\uC2DC \uC18C\uD658\uD558\uBA74 \uAE30\uC874 \uB3C4\uAE68\uBE44\uBD88\uC774
    \uC0AC\uB77C\uC9D1\uB2C8\uB2E4. \uACF5\uACA9\uC18D\uB3C4 \uC99D\uAC15\uC740 \uD22C\uC0AC\uCCB4
    \uBC1C\uC0AC \uAC04\uACA9\uC5D0\uB9CC \uC801\uC6A9\uB429\uB2C8\uB2E4."
  baseStats: "\uBC1C\uB3D9 \uAC04\uACA9 15\uCD08 / \uC18C\uD658 \uC218\uB7C9 1\uAC1C
    / \uC9C0\uC18D\uC2DC\uAC04 12\uCD08\n\uACF5\uC804 \uBC18\uACBD 1.5m / \uACF5\uC804
    \uC18D\uB3C4 120\uB3C4/\uCD08 / \uC801 \uAC10\uC9C0 \uBC18\uACBD 3m\n\uD22C\uC0AC\uCCB4
    \uC218 1\uAC1C / \uD22C\uC0AC\uCCB4 \uC774\uB3D9\uC18D\uB3C4 7m/s / \uAE30\uBCF8
    \uACF5\uACA9 \uAC04\uACA9 1.2\uCD08 / \uC0DD\uC131 \uAC70\uB9AC \uC804\uBC29
    1m"
